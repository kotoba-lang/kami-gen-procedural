;; kami-gen-procedural — deterministic EDN-parameter composed character
;; pipeline (ADR-2607051100, com-junkawasaki/root). :local/root sibling
;; deps, same convention as the 3 existing "actor" repos' langgraph-clj
;; override (CLAUDE.md "Actors" section) and this org's other kotoba-lang
;; sibling checkouts under orgs/kotoba-lang/*.
{:paths ["src" "test"]
 :deps {io.github.kotoba-lang/character  {:git/url "https://github.com/kotoba-lang/character.git"
                                     :git/sha "197410ae8fab61c2bc46c690fc6affbec046928f"}
        io.github.kotoba-lang/mesher     {:git/url "https://github.com/kotoba-lang/mesher.git"
                                     :git/sha "4eba597c2b50e1b77d256e62bc0289f1e5fb3f51"}
        io.github.kotoba-lang/vegetation {:git/url "https://github.com/kotoba-lang/vegetation.git"
                                     :git/sha "101c24697f5dd2e40fd08aba288a86c1179fc08a"}
        io.github.kotoba-lang/org-vrmc-vrm {:git/url "https://github.com/kotoba-lang/org-vrmc-vrm.git"
                                     :git/sha "8d8725af2feb4666cfd9573a30cc879b5fd43878"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]}
           ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
           :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
                  :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                              "--fail-level" "error"]}}}